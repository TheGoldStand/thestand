-- ==================== Управление окном Temple -> Inv ====================
local templeInvFrame = nil
local templeInvOpenBtn = nil

local function createTempleInvWindow()
    if templeInvFrame then
        templeInvFrame.Visible = true
        return
    end

    -- Главное окно функции
    templeInvFrame = Instance.new("Frame")
    templeInvFrame.Size = UDim2.new(0, 320, 0, 300)
    templeInvFrame.Position = UDim2.new(0.5, -160, 0.4, 0)
    templeInvFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    templeInvFrame.BackgroundTransparency = 0.15
    templeInvFrame.BorderSizePixel = 0
    templeInvFrame.ClipsDescendants = true
    templeInvFrame.Active = true
    templeInvFrame.Visible = true
    templeInvFrame.Parent = gui

    local tStroke = Instance.new("UIStroke", templeInvFrame)
    tStroke.Thickness = 2.5
    tStroke.LineJoinMode = Enum.LineJoinMode.Round
    tStroke.Color = Color3.fromRGB(255, 200, 0)
    Instance.new("UICorner", templeInvFrame).CornerRadius = UDim.new(0, 14)

    -- Шапка окна
    local header = Instance.new("Frame", templeInvFrame)
    header.Size = UDim2.new(1, 0, 0, 36)
    header.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    header.BorderSizePixel = 0
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 14)

    local hGrad = Instance.new("UIGradient", header)
    hGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 220, 50)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 180, 0))
    })
    hGrad.Rotation = 90

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(1, -70, 1, 0)
    title.Position = UDim2.new(0, 15, 0, 0)
    title.Text = "Temple to Inv Copier"
    title.TextColor3 = Color3.fromRGB(180, 0, 0)
    title.TextSize = 15
    title.Font = Enum.Font.GothamBold
    title.BackgroundTransparency = 1
    title.TextXAlignment = Enum.TextXAlignment.Left

    local closeBtn = Instance.new("TextButton", header)
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -33, 0, 3)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.fromRGB(180, 0, 0)
    closeBtn.TextSize = 18
    closeBtn.Font = Enum.Font.GothamBold

    makeDraggable(header, templeInvFrame)

    -- Контентная часть
    local contentHolder = Instance.new("Frame", templeInvFrame)
    contentHolder.Size = UDim2.new(1, 0, 1, -36)
    contentHolder.Position = UDim2.new(0, 0, 0, 36)
    contentHolder.BackgroundTransparency = 1

    -- Выбранный объект хранилище
    local selectedViewFrame = nil

    -- Кнопка "Выбрать"
    local selectBtn = Instance.new("TextButton", contentHolder)
    selectBtn.Size = UDim2.new(1, -30, 0, 45)
    selectBtn.Position = UDim2.new(0, 15, 0, 20)
    selectBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    selectBtn.Text = "Выбрать: Не выбрано"
    selectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    selectBtn.Font = Enum.Font.GothamSemibold
    selectBtn.TextSize = 14
    selectBtn.BorderSizePixel = 0
    Instance.new("UICorner", selectBtn).CornerRadius = UDim.new(0, 8)

    -- Кнопка "Копировать"
    local copyBtn = Instance.new("TextButton", contentHolder)
    copyBtn.Size = UDim2.new(1, -30, 0, 45)
    copyBtn.Position = UDim2.new(0, 15, 0, 80)
    copyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    copyBtn.Text = "Копировать в Inv"
    copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    copyBtn.Font = Enum.Font.GothamBold
    copyBtn.TextSize = 15
    copyBtn.BorderSizePixel = 0
    Instance.new("UICorner", copyBtn).CornerRadius = UDim.new(0, 8)

    -- Статус / Информация
    local statusLabel = Instance.new("TextLabel", contentHolder)
    statusLabel.Size = UDim2.new(1, -30, 0, 40)
    statusLabel.Position = UDim2.new(0, 15, 0, 140)
    statusLabel.Text = ""
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.TextSize = 13
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextWrapped = true

    -- Окно со списком ViewportFrame из Temple
    local listWindow = nil
    local function openTempleSelector()
        if listWindow then listWindow:Destroy() end

        listWindow = Instance.new("Frame")
        listWindow.Size = UDim2.new(0, 260, 0, 200)
        listWindow.Position = UDim2.new(0.5, -130, 0.5, -80)
        listWindow.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        listWindow.BorderSizePixel = 0
        listWindow.Active = true
        listWindow.Parent = gui
        Instance.new("UICorner", listWindow).CornerRadius = UDim.new(0, 10)
        Instance.new("UIStroke", listWindow).Color = Color3.fromRGB(255, 200, 0)

        local lHeader = Instance.new("Frame", listWindow)
        lHeader.Size = UDim2.new(1, 0, 0, 30)
        lHeader.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        Instance.new("UICorner", lHeader).CornerRadius = UDim.new(0, 10)

        local lTitle = Instance.new("TextLabel", lHeader)
        lTitle.Size = UDim2.new(1, -30, 1, 0)
        lTitle.Position = UDim2.new(0, 10, 0, 0)
        lTitle.Text = "Выберите ViewportFrame"
        lTitle.TextColor3 = Color3.fromRGB(180, 0, 0)
        lTitle.Font = Enum.Font.GothamBold
        lTitle.TextSize = 13
        lTitle.BackgroundTransparency = 1
        lTitle.TextXAlignment = Enum.TextXAlignment.Left

        local lClose = Instance.new("TextButton", lHeader)
        lClose.Size = UDim2.new(0, 30, 1, 0)
        lClose.Position = UDim2.new(1, -30, 0, 0)
        lClose.BackgroundTransparency = 1
        lClose.Text = "✕"
        lClose.TextColor3 = Color3.fromRGB(180, 0, 0)
        lClose.Font = Enum.Font.GothamBold
        lClose.MouseButton1Click:Connect(function()
            listWindow:Destroy()
            listWindow = nil
        end)

        makeDraggable(lHeader, listWindow)

        local scrolling = Instance.new("ScrollingFrame", listWindow)
        scrolling.Size = UDim2.new(1, 0, 1, -30)
        scrolling.Position = UDim2.new(0, 0, 0, 30)
        scrolling.BackgroundTransparency = 1
        scrolling.ScrollBarThickness = 4

        local scLayout = Instance.new("UIListLayout", scrolling)
        scLayout.SortOrder = Enum.SortOrder.LayoutOrder
        scLayout.Padding = UDim.new(0, 4)

        -- Ищем папку/фрейм Temple в PlayerGui или Workspace
        local templeFolder = LocalPlayer.PlayerGui:FindFirstChild("Temple", true) or Workspace:FindFirstChild("Temple", true)
        
        local count = 0
        if templeFolder then
            for _, obj in ipairs(templeFolder:GetDescendants()) do
                if obj:IsA("ViewportFrame") then
                    count = count + 1
                    local itemBtn = Instance.new("TextButton")
                    itemBtn.Size = UDim2.new(1, -10, 0, 32)
                    itemBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
                    itemBtn.Text = obj.Name
                    itemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    itemBtn.Font = Enum.Font.GothamSemibold
                    itemBtn.TextSize = 12
                    itemBtn.BorderSizePixel = 0
                    Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 6)
                    itemBtn.Parent = scrolling

                    itemBtn.MouseButton1Click:Connect(function()
                        selectedViewFrame = obj
                        selectBtn.Text = "Выбран: " .. obj.Name
                        statusLabel.Text = "Готов к копированию."
                        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                        listWindow:Destroy()
                        listWindow = nil
                    end)
                end
            end
        end

        if count == 0 then
            local errLbl = Instance.new("TextLabel", scrolling)
            errLbl.Size = UDim2.new(1, 0, 0, 40)
            errLbl.BackgroundTransparency = 1
            errLbl.Text = "Temple или ViewportFrame не найдены!"
            errLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
            errLbl.Font = Enum.Font.Gotham
            errLbl.TextSize = 12
        end

        scrolling.CanvasSize = UDim2.new(0, 0, 0, count * 36)
    end

    selectBtn.MouseButton1Click:Connect(function()
        openTempleSelector()
    end)

    -- Логика кнопки копирования в "Inv"
    copyBtn.MouseButton1Click:Connect(function()
        if not selectedViewFrame then
            statusLabel.Text = "Ошибка: Сначала выберите ViewportFrame!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            return
        end

        -- Ищем папку/фрейм Inv
        local invFolder = LocalPlayer.PlayerGui:FindFirstChild("Inv", true) or Workspace:FindFirstChild("Inv", true)
        if not invFolder then
            statusLabel.Text = "Ошибка: Фрейм/папка 'Inv' не найдена!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            return
        end

        -- Клонируем выбранный элемент в Inv
        local cloned = selectedViewFrame:Clone()
        cloned.Parent = invFolder
        statusLabel.Text = "Успешно скопировано в Inv!"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    end)

    closeBtn.MouseButton1Click:Connect(function()
        templeInvFrame.Visible = false
        if listWindow then listWindow:Destroy(); listWindow = nil end
    end)
end

-- Кнопка для открытия этого меню в вашем главном меню хаба (gameListContent)
createGameButton(gameListContent, 130, "📦 Temple & Inv Copier", function()
    createTempleInvFunction() -- либо вызов createTempleInvWindow()
end)
