local function makeDraggable(dragArea, moveTarget)
    local dragging = false
    local startPos = nil
    local dragStart = nil
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = moveTarget.Position
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            moveTarget.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
makeDraggable(header, mainFrame)

local function createButton(y, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -30, 0, 40)
    btn.Position = UDim2.new(0, 15, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(60, 90, 230)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Active = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local grad = Instance.new("UIGradient", btn)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 100, 240)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 70, 200))
    })
    grad.Rotation = 90
    btn.MouseButton1Click:Connect(callback)
    btn.Parent = mainFrame
    return btn
end

-- Находим целевой ScreenGui с названием "ScreenGui"
local function findTargetScreenGui()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    for _, child in ipairs(playerGui:GetChildren()) do
        if child:IsA("ScreenGui") and child.Name == "ScreenGui" and child ~= gui then
            return child
        end
    end
    return nil
end

-- Ищем Temple и Inv внутри найденного ScreenGui
local function getTempleAndInv()
    local target = findTargetScreenGui()
    if not target then return nil, nil end
    local temple = target:FindFirstChild("Temple")
    local inv = target:FindFirstChild("Inv")
    return temple, inv
end

local listFrame = nil

local function createListWindow(frames)
    if listFrame then listFrame:Destroy() end

    listFrame = Instance.new("Frame")
    listFrame.Size = UDim2.new(0, 220, 0, 280)
    listFrame.Position = UDim2.new(0.5, 130, 0.3, 0)
    listFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    listFrame.BackgroundTransparency = 0.15
    listFrame.BorderSizePixel = 0
    listFrame.Active = true
    listFrame.Parent = gui

    local lStroke = Instance.new("UIStroke", listFrame)
    lStroke.Thickness = 2.5
    lStroke.LineJoinMode = Enum.LineJoinMode.Round
    task.spawn(function()
        while true do
            for _, c in ipairs({Color3.fromRGB(255,200,0), Color3.fromRGB(255,230,50), Color3.fromRGB(255,170,0), Color3.fromRGB(255,215,0)}) do
                lStroke.Color = c
                task.wait(0.4)
            end
        end
    end)
    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 14)

    local lHeader = Instance.new("Frame", listFrame)
    lHeader.Size = UDim2.new(1, 0, 0, 32)
    lHeader.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    lHeader.BorderSizePixel = 0
    Instance.new("UICorner", lHeader).CornerRadius = UDim.new(0, 14)
    local lhGrad = Instance.new("UIGradient", lHeader)
    lhGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 220, 50)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 180, 0))
    })
    lhGrad.Rotation = 90

    local lTitle = Instance.new("TextLabel", lHeader)
    lTitle.Size = UDim2.new(1, -30, 1, 0)
    lTitle.Position = UDim2.new(0, 10, 0, 0)
    lTitle.Text = "Temple Frames"
    lTitle.TextColor3 = Color3.fromRGB(180, 0, 0)
    lTitle.Font = Enum.Font.GothamBold
    lTitle.TextSize = 14
    lTitle.BackgroundTransparency = 1
    lTitle.TextXAlignment = Enum.TextXAlignment.Left

    local lClose = Instance.new("TextButton", lHeader)
    lClose.Size = UDim2.new(0, 30, 1, 0)
    lClose.Position = UDim2.new(1, -30, 0, 0)
    lClose.BackgroundTransparency = 1
    lClose.Text = "✕"
    lClose.TextColor3 = Color3.fromRGB(180, 0, 0)
    lClose.Font = Enum.Font.GothamBold
    lClose.TextSize = 16
    lClose.MouseButton1Click:Connect(function()
        listFrame:Destroy()
        listFrame = nil
    end)

    makeDraggable(lHeader, listFrame)

    local lScroll = Instance.new("ScrollingFrame", listFrame)
    lScroll.Size = UDim2.new(1, 0, 1, -32)
    lScroll.Position = UDim2.new(0, 0, 0, 32)
    lScroll.BackgroundTransparency = 1
    lScroll.BorderSizePixel = 0
    lScroll.ScrollBarThickness = 4
    lScroll.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
    lScroll.ScrollBarImageTransparency = 0.8
    lScroll.CanvasSize = UDim2.new(0, 0, 0, 0)

    local lContent = Instance.new("Frame", lScroll)
    lContent.Size = UDim2.new(1, 0, 0, 0)
    lContent.BackgroundTransparency = 1

    local y = 0
    for _, frameObj in ipairs(frames) do
        local entry = Instance.new("TextButton")
        entry.Size = UDim2.new(1, -10, 0, 32)
        entry.Position = UDim2.new(0, 5, 0, y)
        entry.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        entry.Text = frameObj.Name
        entry.TextColor3 = Color3.fromRGB(255, 255, 255)
        entry.Font = Enum.Font.GothamSemibold
        entry.TextSize = 13
        entry.BorderSizePixel = 0
        entry.AutoButtonColor = false
        entry.Active = true
        Instance.new("UICorner", entry).CornerRadius = UDim.new(0, 6)
        entry.Parent = lContent

        entry.MouseButton1Click:Connect(function()
            selectedFrame = frameObj
            for _, child in ipairs(lContent:GetChildren()) do
                if child:IsA("TextButton") then
                    child.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                end
            end
            entry.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
        end)

        y = y + 36
    end

    lContent.Size = UDim2.new(1, 0, 0, y)
    lScroll.CanvasSize = UDim2.new(0, 0, 0, y)
end

createButton(34, "Chose", function()
    local temple, _ = getTempleAndInv()
    if not temple then return end
    local allFrames = {}
    for _, child in ipairs(temple:GetChildren()) do
        if child:IsA("Frame") then
            table.insert(allFrames, child)
        end
    end
    if #allFrames == 0 then return end
    createListWindow(allFrames)
end)

createButton(90, "Copy", function()
    if not selectedFrame then return end
    local _, inv = getTempleAndInv()
    if not inv then return end
    local clone = selectedFrame:Clone()
    clone.Parent = inv
end)
