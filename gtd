-- 3. Функция перетаскивания окна
local function makeDraggable(gui)
	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startPos = nil

	local function update(input)
		local delta = input.Position - dragStart
		gui.Position = UDim2.new(
			startPos.X.Scale, 
			startPos.X.Offset + delta.X, 
			startPos.Y.Scale, 
			startPos.Y.Offset + delta.Y
		)
	end

	gui.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = gui.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	gui.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end

makeDraggable(controlPanel)

-- 4. Логика поиска и копирования ViewportFrame
local function updateViewportList()
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local count = 0
	for _, child in ipairs(templeFrame:GetChildren()) do
		if child:IsA("ViewportFrame") then
			count = count + 1
			
			local itemBtn = Instance.new("TextButton")
			itemBtn.Size = UDim2.new(1, -8, 0, 30)
			itemBtn.BackgroundColor3 = (selectedViewport == child) and Color3.fromRGB(80, 80, 120) or Color3.fromRGB(45, 45, 55)
			itemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			itemBtn.Text = child.Name
			itemBtn.Font = Enum.Font.SourceSans
			itemBtn.TextSize = 16
			itemBtn.Parent = listFrame

			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 4)
			btnCorner.Parent = itemBtn

			itemBtn.MouseButton1Click:Connect(function()
				selectedViewport = child
				selectButton.Text = "Выбрано: " .. child.Name
				listFrame.Visible = false
			end)
		end
	end

	if count == 0 then
		selectButton.Text = "В Temple нет ViewportFrame!"
	end
end

selectButton.MouseButton1Click:Connect(function`()
	listFrame.Visible = not listFrame.Visible
	if listFrame.Visible then
		updateViewportList()
	end
end)

copyButton.MouseButton1Click:Connect(function()
	if not selectedViewport then
		warn("[UI Error] Сначала выберите ViewportFrame!")
		return
	end

	local clone = selectedViewport:Clone()
	clone.Name = selectedViewport.Name .. "_Copy"
	clone.Parent = invFrame
	clone.Visible = true

	print("[UI] Успешно скопировано в Inv:", clone.Name)
end)
